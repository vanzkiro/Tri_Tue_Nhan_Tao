import numpy as np
import pandas as pd
from sklearn.datasets import load_iris
from sklearn.metrics import accuracy_score, classification_report, confusion_matrix
from sklearn.model_selection import train_test_split
from sklearn.naive_bayes import GaussianNB

# Tải tập dữ liệu Iris
iris = load_iris()
X = pd.DataFrame(iris.data, columns=iris.feature_names)
y = pd.Series(iris.target, name='target')
target_names = iris.target_names

# Chia tập dữ liệu Hold-out: 2/3 Train (100 mẫu), 1/3 Test (50 mẫu)
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=1 / 3, random_state=42, stratify=y
)

# Khởi tạo và huấn luyện mô hình Gaussian Naive Bayes
gnb = GaussianNB()
gnb.fit(X_train, y_train)

# Dự đoán trên tập kiểm thử (Test set)
y_pred = gnb.predict(X_test)

# Đánh giá hiệu năng và trích xuất tham số
print(
    f'Kích thước Train: {len(X_train)} mẫu | Kích thước Test: {len(X_test)} mẫu'
)
print(f'Accuracy: {accuracy_score(y_test, y_pred) * 100:.2f}%\n')

print('--- Classification Report ---')
print(classification_report(y_test, y_pred, target_names=target_names))

print('--- Confusion Matrix ---')
print(
    pd.DataFrame(
        confusion_matrix(y_test, y_pred),
        index=target_names,
        columns=target_names,
    )
)

# Trích xuất tham số phân phối Gaussian (Trung bình μ và Độ lệch chuẩn σ)
means = pd.DataFrame(
    gnb.theta_, index=target_names, columns=iris.feature_names
)
stds = pd.DataFrame(
    np.sqrt(gnb.var_), index=target_names, columns=iris.feature_names
)

print('\nGiá trị Trung bình (Mean μ):')
print(means)

print('\nĐộ lệch chuẩn (Standard Deviation σ):')
print(stds)